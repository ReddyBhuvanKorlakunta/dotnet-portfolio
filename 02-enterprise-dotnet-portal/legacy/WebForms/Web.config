<configuration><system.web><compilation debug="false" targetFramework="4.8"/><httpRuntime targetFramework="4.8" enableVersionHeader="false"/><authentication mode="Windows"/><authorization><deny users="?"/></authorization><pages validateRequest="true" enableViewStateMac="true" viewStateEncryptionMode="Always"/><httpCookies httpOnlyCookies="true" requireSSL="true" sameSite="Strict"/><customErrors mode="On"/></system.web><system.webServer><httpProtocol><customHeaders><remove name="X-Powered-By"/><add name="X-Content-Type-Options" value="nosniff"/><add name="X-Frame-Options" value="DENY"/></customHeaders></httpProtocol></system.webServer></configuration>
