@model IEnumerable<EnterprisePortal.Models.CaseRecord>
<h2>Recent cases (dummy data)</h2>
<table>
<thead><tr><th scope="col">Reference</th><th scope="col">Status</th><th scope="col">Created</th></tr></thead>
<tbody>
@foreach (var c in Model)
{
  <tr><td>@c.Reference</td><td>@c.Status</td><td>@c.CreatedAt.ToString("yyyy-MM-dd")</td></tr>
}
</tbody>
</table>
<p>Same data is available as JSON at <code>/api/cases</code> for authorised roles, and as a legacy Web Forms page in <code>legacy/WebForms/</code>.</p>
