@model EnterprisePortal.Application.Cases.CaseDetail
<h1>@Model.Title</h1>
<dl><dt>Reference</dt><dd>@Model.Reference</dd><dt>Status</dt><dd>@Model.Status</dd><dt>Applicant</dt><dd>@Model.ApplicantName</dd></dl>
<p>@Model.Description</p>
<h2>Notes</h2>
<ul>@foreach (var n in Model.Notes) { <li>@n</li> }</ul>
<p><a href="/">Back to cases</a></p>
