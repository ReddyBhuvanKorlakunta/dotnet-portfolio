@model CreateCaseRequest
@{ViewData["Title"]="Create a case";}
<a asp-action="Index">← Back to cases</a><p class="eyebrow">NEW REQUEST</p><h1>Create a case</h1><p>All fields are required unless marked optional. Use fictional information.</p>
<form method="post" asp-action="Create" class="panel form-panel"><div asp-validation-summary="All" class="error-summary" tabindex="-1"></div>
<fieldset><legend>Request details</legend><label asp-for="Title">Case title</label><input asp-for="Title" maxlength="200" required><label asp-for="Type">Request type</label><select asp-for="Type" asp-items="Html.GetEnumSelectList<CaseType>()"></select><label asp-for="Priority">Priority</label><select asp-for="Priority" asp-items="Html.GetEnumSelectList<CasePriority>()"></select><label asp-for="Description">Description (optional)</label><textarea asp-for="Description" maxlength="2000" rows="4"></textarea></fieldset>
<fieldset><legend>Applicant information</legend><label asp-for="ApplicantName">Applicant name</label><input asp-for="ApplicantName" autocomplete="name" maxlength="200" required><label asp-for="ApplicantEmail">Applicant email</label><input asp-for="ApplicantEmail" type="email" autocomplete="email" maxlength="200" required><label asp-for="Notes">Restricted notes (optional)</label><textarea asp-for="Notes" maxlength="2000" rows="3" aria-describedby="notes-help"></textarea><p id="notes-help" class="hint">Encrypted before storage. Excluded from case responses. Use synthetic data only.</p></fieldset><div class="actions"><button>Submit case</button><a asp-action="Index">Cancel</a></div></form>
