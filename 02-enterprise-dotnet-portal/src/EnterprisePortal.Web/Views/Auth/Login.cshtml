@model EnterprisePortal.Web.Controllers.LoginModel
@{ ViewData["Title"]="Sign in"; }
<div class="login"><div><p class="eyebrow">SECURE STAFF WORKSPACE</p><h1>Better service.<br>One case at a time.</h1><p class="lede">Review community assistance requests in an accessible, consistent workspace.</p><ul class="features"><li>Clear, guided case decisions</li><li>Keyboard accessible workflows</li><li>Encrypted demonstration records</li></ul></div>
<section class="panel"><h2>Sign in</h2><p>Use your configured demonstration password.</p><form method="post" asp-action="Login"><div asp-validation-summary="All" class="error-summary" tabindex="-1"></div><input asp-for="ReturnUrl" type="hidden"><label asp-for="Email">Email address</label><input asp-for="Email" autocomplete="username" aria-describedby="email-help"><p id="email-help" class="hint">worker@example.test or auditor@example.test</p><label asp-for="Password">Password</label><input asp-for="Password" type="password" autocomplete="current-password"><button type="submit">Sign in securely</button></form><p class="hint">Your session expires after 20 minutes. Save your work before signing out.</p></section></div>
